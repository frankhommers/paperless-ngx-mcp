{
  "name": "@frankhommers/paperless-ngx-mcp",
  "version": "1.2.0",
  "description": "Model Context Protocol (MCP) server for interacting with Paperless-NGX document management system. Enables AI assistants to manage documents, tags, correspondents, and document types through the Paperless-NGX API.",
  "main": "build/index.js",
  "bin": {
    "paperless-mcp": "build/index.js"
  },
  "scripts": {
    "test": "npm run contract:check && npm run build && node --test test/*.test.cjs",
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector node build/index.js",
    "prepare": "npm run build",
    "contract:generate": "node scripts/generate-contract.mjs",
    "contract:check": "node scripts/generate-contract.mjs --check && tsc --project test/tsconfig.contract.json",
    "test:live": "npm run build && node scripts/smoke-live.cjs"
  },
  "keywords": [
    "mcp",
    "paperless-ngx",
    "document-management",
    "ai",
    "claude",
    "model-context-protocol",
    "paperless"
  ],
  "author": "Nick Loui",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankhommers/paperless-ngx-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@modelcontextprotocol/server-legacy": "2.1.0",
    "express": "^5.1.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^22.15.17",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "ts-node": "^10.9.2",
    "yaml": "2.9.1"
  },
  "files": [
    "build",
    "README.md",
    "docs",
    "THIRD_PARTY_NOTICES.md",
    "specs/LICENSE.apigen",
    "specs/LICENSE.paperless-ngx",
    "specs/README.md"
  ],
  "engines": {
    "node": ">=20"
  }
}
